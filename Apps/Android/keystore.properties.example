# Non-secret release signing settings.
# scripts/create_upload_keystore.sh creates the ignored keystore.properties file.
storeFile=/Users/your-name/Library/Application Support/Dday/Signing/Android/dday-upload-key.jks
keyAlias=dday-upload

# Pass passwords through these environment variables instead of committing them:
# DDAY_ANDROID_STORE_PASSWORD
# DDAY_ANDROID_KEY_PASSWORD
